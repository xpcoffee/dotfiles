{
  "env": {
    "CLAUDE_ENV_FILE": "/home/rick/.claude_env"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "mcp__ado__*",
      "mcp__grafana__*",
      "mcp__github__*",
      "mcp__nvim-markdown-notes-memgraph__*",
      "mcp__playwright__*",
      "WebFetch",
      "WebSearch",
      "Bash(az:*)",
      "Bash(aiq:*)",
      "Edit(/tmp/**)",
      "Read(/tmp/**)",
      "Read(~/.claude/skills/**)",
      "Edit(/home/emerick/code/work/**)",
      "Read(/home/emerick/code/work/**)",
      "Edit(/home/emerick/code/personal/**)",
      "Read(/home/emerick/code/personal/**)",
      "Bash(python3 -m http.server:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(npx oxfmt:*)",
      "Bash(npx tsc:*)",
      "Bash(jq:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(ps:*)",
      "Bash(dotnet:*)",
      "Bash(git:*)",
      "Bash(uv:*)",
      "Bash(awk:*)",
      "Bash(find:*)",
      "Bash(echo:*)",
      "Bash(grep:*)",
      "Bash(tee:*)",
      "Bash(test:*)",
      "Bash(make:*)",
      "Bash(sleep:*)",
      "Bash(xargs:*)",
      "Bash(tail:*)",
      "Bash(pandoc:*)",
      "Bash(docker:*)",
      "Bash(gh:*)",
      "Bash(go test:*)",
      "Bash(gcloud:*)",
      "Bash(npm:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "enabledPlugins": {
    "nvim-markdown-notes-memgraph@xpcoffee-plugins": true
  },
  "extraKnownMarketplaces": {
    "xpcoffee-notes": {
      "source": {
        "source": "directory",
        "path": "/home/rick/code/personal/notes"
      }
    }
  },
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "/home/emerick/code/work/**",
        "/home/emerick/code/personal/**"
      ],
      "allowRead": [
        "/home/emerick/code/work/**",
        "/home/emerick/code/personal/**"
      ]
    }
  },
  "spinnerTipsEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true
}
