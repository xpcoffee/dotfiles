.shell powershell

# Gaming escape hatch. Toggles EVERY hotkey below off and on again,
# so a game receives Alt+<key> itself instead of whkd swallowing it.
# This is the binding to press before and after playing.
#
# It has to be whkd's own `.pause`, not `komorebic toggle-pause`:
# pausing komorebi only stops it tiling, whkd still intercepts the
# keystroke and the game never sees it.
#
# Ctrl+Alt is used rather than plain Alt so this stays reachable
# while a game is holding Alt combos.
.pause ctrl + alt + p

# ============================================================
# Modifier: ALT
#
# This deliberately does NOT use the Windows/Super key, even
# though the omarchy/Hyprland side does. Windows reserves a
# number of Win+<key> combos below the level whkd's low-level
# keyboard hook can intercept: Win+L (lock workstation) is
# effectively uninterceptable, and Win+H (voice typing) wins
# over whkd in practice. Binding them anyway just produces
# hotkeys that silently do the wrong thing.
#
# Alt is komorebi's own default modifier and has no equivalent
# reserved combos. The cost is that muscle memory no longer
# carries over from the Linux side, which stays on Super -- see
# ../hypr/tiling-consistency.conf.
#
# Alt+Tab (window switcher) and Alt+F4 (close) are deliberately
# left to Windows.
# ============================================================

# ============================================================
# Reload / diagnostics
# ============================================================
alt + ctrl + r          : komorebic reload-configuration
alt + shift + r         : komorebic retile
alt + i                 : komorebic toggle-shortcuts

# ============================================================
# Focus a tile
#
# hjkl only, no arrow-key duplicates: Alt+Left and Alt+Right are
# Back/Forward in browsers and File Explorer, and binding them
# here would swallow those everywhere.
# ============================================================
alt + h                 : komorebic focus left
alt + j                 : komorebic focus down
alt + k                 : komorebic focus up
alt + l                 : komorebic focus right

# Quick toggle to the PREVIOUSLY FOCUSED tile in this workspace
# (e.g. bounce between a terminal and a browser). Key is the
# backtick/grave key, just left of "1" on a US layout.
alt + oem_3             : komorebic cycle-focus previous

# ============================================================
# Move a tile
# ============================================================
alt + shift + h         : komorebic move left
alt + shift + j         : komorebic move down
alt + shift + k         : komorebic move up
alt + shift + l         : komorebic move right

# ============================================================
# Resize the focused tile
# ============================================================
alt + ctrl + h          : komorebic resize-edge left increase
alt + ctrl + j          : komorebic resize-edge down increase
alt + ctrl + k          : komorebic resize-edge up increase
alt + ctrl + l          : komorebic resize-edge right increase

alt + ctrl + shift + h  : komorebic resize-edge left decrease
alt + ctrl + shift + j  : komorebic resize-edge down decrease
alt + ctrl + shift + k  : komorebic resize-edge up decrease
alt + ctrl + shift + l  : komorebic resize-edge right decrease

# ============================================================
# Workspaces (Alt+1..9 to jump, Alt+Shift+1..9 to send a window
# there)
# ============================================================
alt + 1                 : komorebic focus-workspace 0
alt + 2                 : komorebic focus-workspace 1
alt + 3                 : komorebic focus-workspace 2
alt + 4                 : komorebic focus-workspace 3
alt + 5                 : komorebic focus-workspace 4
alt + 6                 : komorebic focus-workspace 5
alt + 7                 : komorebic focus-workspace 6
alt + 8                 : komorebic focus-workspace 7
alt + 9                 : komorebic focus-workspace 8

alt + shift + 1         : komorebic move-to-workspace 0
alt + shift + 2         : komorebic move-to-workspace 1
alt + shift + 3         : komorebic move-to-workspace 2
alt + shift + 4         : komorebic move-to-workspace 3
alt + shift + 5         : komorebic move-to-workspace 4
alt + shift + 6         : komorebic move-to-workspace 5
alt + shift + 7         : komorebic move-to-workspace 6
alt + shift + 8         : komorebic move-to-workspace 7
alt + shift + 9         : komorebic move-to-workspace 8

# Cycle workspaces with [ and ]. Alt+Tab is left alone so that
# Windows' own window switcher keeps working. Shift+backtick
# jumps back to the last workspace, pairing with the plain
# backtick binding above for the last tile.
alt + oem_4             : komorebic cycle-workspace previous
alt + oem_6             : komorebic cycle-workspace next
alt + shift + oem_3     : komorebic focus-last-workspace

# ============================================================
# Window state
# ============================================================
alt + f                  : komorebic toggle-monocle
alt + t                  : komorebic toggle-float
alt + q                  : komorebic close
alt + m                  : komorebic minimize
alt + shift + p          : komorebic promote

# ============================================================
# Layout
# ============================================================
alt + x                  : komorebic flip-layout horizontal
alt + y                  : komorebic flip-layout vertical

# ============================================================
# Pause komorebi's tiling, so it stops managing/resizing windows.
# Useful for a game that misbehaves when tiled, but note this does
# NOT free up the keyboard -- whkd still intercepts every binding
# above. Use `.pause` (Ctrl+Alt+P, top of this file) for that.
# ============================================================
alt + p                  : komorebic toggle-pause
